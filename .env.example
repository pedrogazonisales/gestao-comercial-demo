# Copie este arquivo para .env e preencha. O .env nunca deve ser compartilhado nem versionado.

# Neon → Connection Details. Pooled (com "-pooler" no endereço):
DATABASE_URL="postgresql://USUARIO:SENHA@ENDERECO-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
# Neon → Connection Details. Direct (sem "-pooler"):
DIRECT_URL="postgresql://USUARIO:SENHA@ENDERECO.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Empresa que usa esta instalação. Tudo opcional: sem preencher, o sistema aparece como "Gestão Comercial" em cores neutras.
# Nome: aparece no título, login, menu, impressão da venda, mensagens de WhatsApp e assistentes de IA.
EMPRESA_NOME=""
# Ramo de atividade (só para os assistentes de IA). Ex.: "moda feminina". Padrão: varejo.
EMPRESA_RAMO=""
# Logotipo: arquivo colocado na pasta public/. Ex.: "/logo.png". Sem ele, o nome aparece em texto.
EMPRESA_LOGO=""
# Cor principal em hexadecimal. Ex.: "#1f4e79".
EMPRESA_COR=""

# Lojas criadas na carga inicial, separadas por ponto e vírgula. Ex.: "Matriz;Filial Centro". Sem preencher: "Loja principal".
SEED_LOJAS=""

# Primeiro administrador (usado só na carga inicial; a senha é trocada no primeiro acesso)
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_SENHA=""

# Assistente de IA (console.anthropic.com, menu API Keys). Nao compartilhe.
ANTHROPIC_API_KEY=""
